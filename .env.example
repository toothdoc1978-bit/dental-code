# Email delivery for the contact form
# Sign up at https://resend.com and create an API key, then add it here.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=info@example.com

# Verified sender on Resend (e.g. no-reply@yourdomain.com).
CONTACT_FROM_EMAIL=no-reply@example.com
